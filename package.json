{
  "name": "herald",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "Herald: a local-first text to speech reader for the browser, built for locked-down assessment environments.",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node tools/build.js",
    "vendor": "node tools/vendor.js",
    "lint": "eslint --fix src/js test",
    "lint:check": "eslint src/js test",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "package": "node tools/package.js",
    "audit:remote": "bash scripts/audit-remote-code.sh dist",
    "audit:manifest": "bash scripts/verify-manifest.sh dist/manifest.json",
    "test:integration": "npm run build && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proctorio/herald.git"
  },
  "keywords": [
    "text-to-speech",
    "chrome-extension",
    "accessibility"
  ],
  "author": "Proctorio",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/proctorio/herald/issues"
  },
  "homepage": "https://github.com/proctorio/herald",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@proctorio/eslint-config": "4.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "@webext-core/fake-browser": "2.0.1",
    "adm-zip": "0.6.0",
    "esbuild": "0.28.2",
    "eslint": "10.0.0",
    "jsdom": "30.0.1",
    "rxjs": "7.8.2",
    "vitest": "4.1.10"
  }
}
